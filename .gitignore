# Claude Code local state. Both settings.json and settings.local.json end up holding
# per-developer permission grants with personal absolute paths and ad-hoc bash allowlists
# that aren't portable across contributors — neither is treated as shared project state
# in this repo. `.claude/skills/` and other shared artifacts under `.claude/` ARE tracked.
.claude/settings.json
.claude/settings.local.json

# MCP server configuration — typically contains per-developer server bindings, paths,
# and (potentially) API tokens. Treat as per-developer state; never commit.
.mcp.json
.mcp.local.json
mcp.json
.claude/mcp.json
.claude/mcp.local.json

# IDE / editor local config — per-developer preferences, not framework content.
.vscode/
.idea/
*.swp
*.swo
.DS_Store
